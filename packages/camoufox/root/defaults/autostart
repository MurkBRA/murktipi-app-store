#!/bin/bash

if [ "${AUTOSTART_BROWSER,,}" == "true" ]; then
  for _ in $(seq 1 150); do
    if /lsiopy/bin/python -c "from camoufox.pkgman import camoufox_path; camoufox_path(download_if_missing=False)" >/dev/null 2>&1; then
      wrapped-camoufox ${CAMOUFOX_CLI} &
      break
    fi
    sleep 2
  done
fi
