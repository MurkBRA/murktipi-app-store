{
  "$schema": "https://raw.githubusercontent.com/runtipi/runtipi-docs/main/src/content/docs/reference/app-config.schema.json",
  "id": "technitium",
  "name": "Technitium DNS Server",
  "port": 5380,
  "available": true,
  "categories": [
    "network",
    "security",
    "utilities"
  ],
  "description": "Technitium DNS Server is an authoritative and recursive DNS server for privacy, security, local network domain resolution, DNS-over-TLS/HTTPS/QUIC, and network-wide ad blocking.",
  "short_desc": "Authoritative & recursive DNS server with ad blocking and DoH/DoT/DoQ support",
  "author": "Technitium Software",
  "tipi_version": 1,
  "version": "13.2.1",
  "source": "https://github.com/TechnitiumSoftware/DnsServer",
  "website": "https://technitium.com/dns/",
  "exposable": true,
  "dynamic_config": true,
  "form_fields": [
