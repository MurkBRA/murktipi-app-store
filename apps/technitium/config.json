      "type": "text",
      "label": "DNS Server Domain Name (FQDN)",
      "hint": "Nome de domínio padrão do servidor DNS.",
      "env_variable": "DNS_SERVER_DOMAIN",
      "default": "technitium-dns",
      "required": true
    },
    {
      "type": "text",
      "label": "DNS Recursion Policy",
      "hint": "Política de recursão de consultas DNS.",
      "env_variable": "DNS_SERVER_RECURSION",
      "default": "Allow",
      "required": true,
      "options": [
        {
          "label": "Allow (Permitir Todas as Redes)",
          "value": "Allow"
        },
        {
          "label": "Allow Only For Private Networks",
          "value": "AllowOnlyForPrivateNetworks"
        },
        {
          "label": "Deny (Negar)",
          "value": "Deny"
        },
        {
          "label": "Use Specified Network ACL",
          "value": "UseSpecifiedNetworkACL"
